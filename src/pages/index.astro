---
import { getCollection } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import { getProjects } from "../lib/projects";

const { intro, projects } = await getProjects();

const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const honourableMentions = (await getCollection("honourableMentions")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const ntnuRelated = (await getCollection("ntnuRelated")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Helper to create optimized thumbnail URL via wsrv.nl
function getThumbnailUrl(imageUrl: string | undefined): string {
	if (!imageUrl) return "";
	// Skip local images (they don't need proxy)
	if (imageUrl.startsWith("/")) return imageUrl;
	// Use wsrv.nl to resize and convert to webp (2x display size for retina)
	return `https://wsrv.nl/?url=${encodeURIComponent(imageUrl)}&w=960&h=640&fit=cover&output=webp&q=85`;
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}
			section {
				padding-top: 3em;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			/* ul li:first-child {
				width: 100%;
				margin-bottom: 1rem;
				text-align: center;
			}
			ul li:first-child img {
				width: 100%;
			}
			ul li:first-child .title {
				font-size: 2.369rem;
			} */
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
				object-fit: cover; /* This ensures the image covers the area */
				object-position: center; /* This centers the image */
				height: 16em; /* Fixed height to maintain aspect ratio */
				width: 100%; /* Width can be 100% of the container */
			}
			ul li a {
				display: block;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
			}
			.description {
				margin: 0;
				color: rgb(var(--gray));
				font-style: italic;
				font-size: medium;
			}
			ul li a:hover h4,
			ul li a:hover .date {
				color: var(--accent);
			}
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}
			.icon-grid {
				display: flex;
				justify-content: center; /* Align the columns centrally */
			}

			.icon-column {
				display: flex;
				flex-direction: column; /* Arrange the items in a column */
				align-items: center; /* Center-align items horizontally */
				padding-right: 1em; /* Space between columns */
			}

			.icon-column a {
				padding-bottom: 1em; /* Space between icons in a column */
			}

			.icon-column a i {
				font-size: 1.5em; /* Icon size */
			}

			/* Subtle side-projects strip — small pills, tucked under the bio */
			section.side-projects {
				padding-top: 2em;
			}
			.side-projects h3 {
				font-size: 1em;
				color: rgb(var(--gray));
			}
			.side-projects .side-projects-intro {
				margin: 0 0 0.75em 0;
				color: rgb(var(--gray));
				font-size: 0.85em;
			}
			ul.projects-list {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6em;
			}
			ul.projects-list li {
				width: auto;
			}
			ul.projects-list li a {
				display: inline-flex;
				align-items: baseline;
				gap: 0.35em;
				max-width: 100%;
				padding: 0.25em 0.9em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 999px;
				font-size: 0.9em;
			}
			ul.projects-list .project-name {
				font-weight: 700;
				color: rgb(var(--black));
				overflow-wrap: anywhere;
			}
			ul.projects-list .project-arrow {
				color: rgb(var(--gray));
				font-size: 0.8em;
			}
			ul.projects-list li a:hover {
				border-color: var(--accent);
			}
			ul.projects-list li a:hover .project-name,
			ul.projects-list li a:hover .project-arrow {
				color: var(--accent);
			}

			@media (max-width: 720px) {
				ul {
					gap: 0.5em;
				}
				ul li {
					width: 100%;
					text-align: center;
				}
				ul li:first-child {
					margin-bottom: 0;
				}
				ul li:first-child .title {
					font-size: 1.563em;
				}
				ul.projects-list {
					justify-content: center;
				}
				.side-projects h3,
				.side-projects .side-projects-intro {
					text-align: center;
				}
			}
		</style>
	</head>
	<body>
		<Header title={SITE_TITLE} />
		<main>
			<div class="icon-grid">
				<div class="icon-column">
					<a href="https://facebook.com/petrepa" target="_blank"
						><i class="fa-brands fa-facebook"></i></a
					>
					<a href="https://instagram.com/petrepa" target="_blank"
						><i class="fa-brands fa-instagram"></i></a
					>
				</div>
				<div class="icon-column">
					<a href="https://twitter.com/petrepa" target="_blank"
						><i class="fa-brands fa-x-twitter"></i></a
					>
					<a
						href="https://www.strava.com/athletes/35722278"
						target="_blank"><i class="fa-brands fa-strava"></i></a
					>
				</div>
				<div class="icon-column">
					<a
						href="https://www.printables.com/@petrepa"
						target="_blank"><i class="fa-solid fa-print"></i></a
					>
					<a href="https://linkedin.com/in/petrepa" target="_blank"
						><i class="fa-brands fa-linkedin"></i></a
					>
				</div>
				<div class="icon-column">
					<a
						href="https://www.reddit.com/user/petrepa"
						target="_blank"
						><i class="fa-brands fa-reddit-alien"></i></a
					>
					<a href="https://github.com/petrepa" target="_blank"
						><i class="fa-brands fa-github"></i></a
					>
				</div>
				<div class="icon-column">
					<a href="https://youtube.com/petrepa" target="_blank"
						><i class="fa-brands fa-youtube"></i></a
					>
					<a
						href="mailto:peter.remoy.paulsen@gmail.com"
						target="_blank"
						><i class="fa-regular fa-envelope"></i></a
					>
				</div>
			</div>

			<div style="text-align: center;">
				<p>
					Hardware engineer at
					<a href="https://scoutdi.com" target="_blank">ScoutDI</a>
					 in Norway, with a
					<a
						href="https://www.ntnu.no/studier/mtelsys"
						target="_blank"
					>
						Master's in Electronic Systems Design
					</a>
					 from NTNU
				</p>
				<h3><a href="/about">More about me</a></h3>
			</div>
			{
				projects.length > 0 && (
					<section class="side-projects">
						<h3>Other Projects</h3>
						{intro && <p class="side-projects-intro">{intro}</p>}
						<ul class="projects-list">
							{projects.map((project) => (
								<li>
									<a
										href={project.url}
										target="_blank"
										rel="noopener noreferrer"
										title={project.description || undefined}
									>
										<span class="project-name">{project.title}</span>
										<span class="project-arrow">↗</span>
									</a>
								</li>
							))}
						</ul>
					</section>
				)
			}
			<section>
				<h3>My Projects</h3>
				<ul>
					{
						posts.map((post) => (
							<li>
								{post.data.moreInfoLink ? (
									<a
										href={post.data.moreInfoLink}
										target="_blank"
										rel="noopener noreferrer"
									>
										<img src={getThumbnailUrl(post.data.heroImage)} alt="" width={480} height={320} loading="lazy" decoding="async" />
										<h4 class="title">{post.data.title}</h4>
										<p class="date">
											<FormattedDate
												date={post.data.pubDate}
											/>
										</p>
									</a>
								) : (
									<a href={`/blog/${post.id}/`}>
										<img src={getThumbnailUrl(post.data.heroImage)} alt="" width={480} height={320} loading="lazy" decoding="async" />
										<h4 class="title">{post.data.title}</h4>
										<p class="date">
											<FormattedDate
												date={post.data.pubDate}
											/>
										</p>
									</a>
								)}
							</li>
						))
					}
				</ul>
			</section>
			<section>
				<h3>Honourable Mentions</h3>
				<ul>
					{
						honourableMentions.map((honourableMentions) => (
							<li>
								{honourableMentions.data.moreInfoLink ? (
									<a
										href={
											honourableMentions.data.moreInfoLink
										}
										target="_blank"
										rel="noopener noreferrer"
									>
										<img
											src={getThumbnailUrl(honourableMentions.data.heroImage)}
											alt=""
											width={480}
											height={320}
											loading="lazy"
											decoding="async"
										/>
										<h4 class="title">
											{honourableMentions.data.title}
										</h4>
										<p class="date">
											<FormattedDate
												date={
													honourableMentions.data
														.pubDate
												}
											/>
										</p>

										<p class="description">
											{
												honourableMentions.data
													.description
											}
										</p>
									</a>
								) : (
									<a
										href={`/blog/${honourableMentions.id}/`}
									>
										<img
											src={getThumbnailUrl(honourableMentions.data.heroImage)}
											alt=""
											width={480}
											height={320}
											loading="lazy"
											decoding="async"
										/>
										<h4 class="title">
											{honourableMentions.data.title}
										</h4>
										<p class="date">
											<FormattedDate
												date={
													honourableMentions.data
														.pubDate
												}
											/>
										</p>
									</a>
								)}
							</li>
						))
					}
				</ul>
			</section>
			<section>
				<h3>NTNU Related</h3>
				<ul>
					{
						ntnuRelated.map((ntnuRelated) => (
							<li>
								{ntnuRelated.data.moreInfoLink ? (
									<a
										href={ntnuRelated.data.moreInfoLink}
										target="_blank"
										rel="noopener noreferrer"
									>
										<img
											src={getThumbnailUrl(ntnuRelated.data.heroImage)}
											alt=""
											width={480}
											height={320}
											loading="lazy"
											decoding="async"
										/>
										<h4 class="title">
											{ntnuRelated.data.title}
										</h4>
										<p class="date">
											<FormattedDate
												date={ntnuRelated.data.pubDate}
											/>
										</p>

										<p class="description">
											{ntnuRelated.data.description}
										</p>
									</a>
								) : (
									<a href={`/blog/${ntnuRelated.id}/`}>
										<img
											src={getThumbnailUrl(ntnuRelated.data.heroImage)}
											alt=""
											width={480}
											height={320}
											loading="lazy"
											decoding="async"
										/>
										<h4 class="title">
											{ntnuRelated.data.title}
										</h4>
										<p class="date">
											<FormattedDate
												date={ntnuRelated.data.pubDate}
											/>
										</p>
									</a>
								)}
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
